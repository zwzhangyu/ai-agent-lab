# ============================================================
# trip_planner 项目所需的密钥清单（模板，勿写真实密钥）
#
# 注意：本项目的密钥统一存放在【仓库根目录】的 .env 文件里
#       即 ai-agent-lab/.env（llm_config.py 会自动向上两级查找它）。
#       请确保根目录 .env 中包含以下几项：
# ============================================================

# ---- 阿里云百炼 / 通义千问（DashScope）——必需，用于 LLM ----
# 获取地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# ---- Tavily 搜索 ——search 工具需要（原示例用的是 Serper，这里已替换）----
# 获取地址：https://www.tavily.com/ （有免费额度）
TAVILY_API_KEY=

# ---- 可选：覆盖默认模型（默认 openai/qwen-max）----
# CREWAI_MODEL=openai/qwen-plus
